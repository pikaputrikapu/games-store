* {
    font-family: "Courier New", monospace;
    color: #00ff41;
    font-size: 13px;
}

GamesWidget {
    background-color: #000000;
}

QLabel {
    color: #00ff41;
    font-size: 18px;
    font-weight: bold;
}

QTableWidget {
    background-color: #0a0a0a;
    gridline-color: #00ff41;
    color: #00ff41;
    border: 1px solid #00ff41;
    selection-background-color: #003300;
}

QTableWidget::item:selected {
    background-color: #003300;
    color: #00ff41;
}

QHeaderView::section {
    background-color: #001a00;
    color: #00ff41;
    border: 1px solid #00ff41;
    padding: 4px;
}

QLineEdit {
    background-color: #0a0a0a;
    color: #00ff41;
    border: 1px solid #00ff41;
    padding: 4px;
}

QLineEdit::placeholder {
    color: #007a1f;
}

QPushButton {
    background-color: #001a00;
    color: #00ff41;
    border: 1px solid #00ff41;
    padding: 5px 15px;
}

QPushButton:hover {
    background-color: #003300;
}

QPushButton:pressed {
    background-color: #004d00;
}

QMessageBox {
    background-color: #000000;
}
